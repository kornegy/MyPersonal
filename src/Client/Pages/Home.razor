@page "/"
@using System.Net.Http.Json
@inject HttpClient Http
@inject IJSRuntime JS

<PageTitle>@(_data?.Profile.FullName ?? "Portfolio") — @(_data?.Profile.Title)</PageTitle>

@if (_data is null)
{
    <div class="app-loader"><div class="app-loader__spinner"></div></div>
}
else
{
    var p = _data.Profile;

    <!-- ===================== NAVBAR ===================== -->
    <header class="navbar-shell">
        <div class="container-x navbar-inner">
            <a href="#top" class="brand">
                <span class="brand__mark @(string.IsNullOrWhiteSpace(p.PhotoUrl) ? "" : "has-photo")">
                    @if (!string.IsNullOrWhiteSpace(p.PhotoUrl))
                    { <img src="@p.PhotoUrl" alt="@p.FullName" /> }
                    else
                    { @Initials(p.FullName) }
                </span>
                <span>@FirstName(p.FullName)</span>
            </a>

            <nav class="nav-links @(_navOpen ? "open" : "")">
                @foreach (var (id, label) in _navItems)
                {
                    <a class="nav-link-dot" data-target="@id" href="#@id" @onclick="CloseNav">@label</a>
                }
            </nav>

            <div class="nav-actions">
                <button class="icon-btn" title="Toggle theme" @onclick="ToggleTheme">
                    <i class="bi @(_theme == "dark" ? "bi-sun" : "bi-moon-stars")"></i>
                </button>
                <button class="icon-btn nav-toggle" title="Menu" @onclick="() => _navOpen = !_navOpen">
                    <i class="bi @(_navOpen ? "bi-x-lg" : "bi-list")"></i>
                </button>
            </div>
        </div>
    </header>

    <main id="top">
        <!-- ===================== HERO ===================== -->
        <section class="hero" id="home">
            <div class="container-x hero-inner">
                <div>
                    @if (!string.IsNullOrWhiteSpace(p.AvailabilityNote))
                    {
                        <span class="pill"><span class="dot"></span>@p.AvailabilityNote</span>
                    }
                    <h1>Hi, I'm @FirstName(p.FullName).<br /><span class="grad">@p.Title</span></h1>
                    <p class="hero-lead">@p.Tagline</p>
                    <div class="hero-cta">
                        <a href="#contact" class="btn-x btn-primary-x"><i class="bi bi-chat-dots"></i>Get in touch</a>
                        @if (!string.IsNullOrWhiteSpace(p.ResumeUrl))
                        {
                            <a href="@p.ResumeUrl" download class="btn-x btn-ghost-x"><i class="bi bi-download"></i>Download CV</a>
                        }
                        <a href="#projects" class="btn-x btn-ghost-x"><i class="bi bi-folder2-open"></i>View my work</a>
                    </div>
                    <div class="hero-socials">
                        @if (!string.IsNullOrWhiteSpace(p.GitHubUrl))
                        { <a class="icon-btn" href="@p.GitHubUrl" target="_blank" title="GitHub"><i class="bi bi-github"></i></a> }
                        @if (!string.IsNullOrWhiteSpace(p.LinkedInUrl))
                        { <a class="icon-btn" href="@p.LinkedInUrl" target="_blank" title="LinkedIn"><i class="bi bi-linkedin"></i></a> }
                        @if (!string.IsNullOrWhiteSpace(p.TelegramUrl))
                        { <a class="icon-btn" href="@p.TelegramUrl" target="_blank" title="Telegram"><i class="bi bi-telegram"></i></a> }
                        @if (!string.IsNullOrWhiteSpace(p.Email))
                        { <a class="icon-btn" href="mailto:@p.Email" title="Email"><i class="bi bi-envelope"></i></a> }
                    </div>
                </div>

                <div class="hero-card">
                    <div class="avatar @(string.IsNullOrWhiteSpace(p.PhotoUrl) ? "" : "has-photo")">
                        @if (!string.IsNullOrWhiteSpace(p.PhotoUrl))
                        { <img src="@p.PhotoUrl" alt="@p.FullName" /> }
                        else
                        { @Initials(p.FullName) }
                    </div>
                    <h3>@p.FullName</h3>
                    <div class="role">@p.Title</div>
                    <p style="color:var(--muted); font-size:.92rem;">
                        <i class="bi bi-geo-alt"></i> @p.Location
                    </p>
                    <div class="hero-stats">
                        <div class="hero-stat"><b>@_data.Projects.Count</b><span>Projects</span></div>
                        <div class="hero-stat"><b>@_data.Skills.Sum(s => s.ItemList().Count())</b><span>Skills</span></div>
                        <div class="hero-stat"><b>@_data.Visits</b><span>Views</span></div>
                    </div>
                </div>
            </div>
        </section>

        <!-- ===================== ABOUT ===================== -->
        <section id="about">
            <div class="container-x reveal">
                <span class="section-tag">About</span>
                <h2 class="section-title">Who I am</h2>
                <p class="section-lead" style="font-size:1.12rem; max-width:820px; color:var(--text);">@p.About</p>
            </div>
        </section>

        <!-- ===================== SERVICES ===================== -->
        <section id="services">
            <div class="container-x">
                <div class="reveal">
                    <span class="section-tag">What I offer</span>
                    <h2 class="section-title">What I can do for your team</h2>
                    <p class="section-lead">Practical skills I bring to a project — from backend and databases to the UI.</p>
                </div>
                <div class="grid grid-2 reveal" style="margin-top:36px;">
                    @foreach (var s in _data.Services)
                    {
                        <div class="card-x">
                            <div class="card-icon"><i class="bi @s.Icon"></i></div>
                            <h3>@s.Title</h3>
                            <p>@s.Description</p>
                        </div>
                    }
                </div>
            </div>
        </section>

        <!-- ===================== SKILLS ===================== -->
        <section id="skills">
            <div class="container-x">
                <div class="reveal">
                    <span class="section-tag">Tech stack</span>
                    <h2 class="section-title">Technologies I work with</h2>
                    <p class="section-lead">The tools I reach for to build reliable, well-structured software.</p>
                </div>
                <div class="grid grid-3 reveal" style="margin-top:36px;">
                    @foreach (var group in _data.Skills)
                    {
                        <div class="skill-group">
                            <h4>@group.Name</h4>
                            <div class="chips">
                                @foreach (var item in group.ItemList())
                                {
                                    <span class="chip">@item</span>
                                }
                            </div>
                        </div>
                    }
                </div>
            </div>
        </section>

        <!-- ===================== EDUCATION ===================== -->
        <section id="education">
            <div class="container-x">
                <div class="reveal">
                    <span class="section-tag">Education</span>
                    <h2 class="section-title">My academic journey</h2>
                </div>
                <div class="timeline reveal" style="margin-top:36px;">
                    @foreach (var e in _data.Experience)
                    {
                        <div class="tl-item">
                            <div class="tl-head">
                                <span class="tl-role">@e.Role</span>
                                <span class="tl-company">· @e.Company</span>
                                <span class="tl-period">@e.Period</span>
                            </div>
                            <p class="tl-summary">@e.Summary</p>
                            @if (e.HighlightLines().Any())
                            {
                                <ul class="tl-list">
                                    @foreach (var h in e.HighlightLines())
                                    {
                                        <li>@h</li>
                                    }
                                </ul>
                            }
                        </div>
                    }
                </div>
            </div>
        </section>

        <!-- ===================== PROJECTS ===================== -->
        <section id="projects">
            <div class="container-x">
                <div class="reveal">
                    <span class="section-tag">Portfolio</span>
                    <h2 class="section-title">Selected projects</h2>
                    <p class="section-lead">A few things I've built. More on my GitHub.</p>
                </div>
                <div class="grid grid-3 reveal" style="margin-top:36px;">
                    @foreach (var proj in _data.Projects)
                    {
                        <div class="card-x project-card">
                            <div class="proj-top">
                                <i class="bi bi-folder2 proj-folder"></i>
                                <div class="proj-links">
                                    @if (!string.IsNullOrWhiteSpace(proj.RepoUrl))
                                    { <a href="@proj.RepoUrl" target="_blank" title="Source"><i class="bi bi-github"></i></a> }
                                    @if (!string.IsNullOrWhiteSpace(proj.LiveUrl))
                                    { <a href="@proj.LiveUrl" target="_blank" title="Live demo"><i class="bi bi-box-arrow-up-right"></i></a> }
                                </div>
                            </div>
                            <h3>@proj.Title</h3>
                            <p>@proj.Description</p>
                            <div class="tech-row">
                                @foreach (var t in proj.Technologies())
                                {
                                    <span class="tech-tag">@t</span>
                                }
                            </div>
                        </div>
                    }
                </div>
                @if (!string.IsNullOrWhiteSpace(p.GitHubUrl))
                {
                    <div class="reveal" style="text-align:center; margin-top:36px;">
                        <a href="@p.GitHubUrl" target="_blank" class="btn-x btn-ghost-x">
                            <i class="bi bi-github"></i>See all projects on GitHub
                        </a>
                    </div>
                }
            </div>
        </section>

        <!-- ===================== CONTACT ===================== -->
        <section id="contact">
            <div class="container-x">
                <div class="reveal">
                    <span class="section-tag">Contact</span>
                    <h2 class="section-title">Let's build something together</h2>
                    <p class="section-lead">Have a project or an idea? Send a message or reach me directly.</p>
                </div>
                <div class="contact-wrap" style="margin-top:36px;">
                    <div class="reveal">
                        <div class="contact-list">
                            @if (!string.IsNullOrWhiteSpace(p.Email))
                            {
                                <a class="contact-row" href="mailto:@p.Email">
                                    <span class="ci"><i class="bi bi-envelope"></i></span>
                                    <span><small>Email</small><b>@p.Email</b></span>
                                </a>
                            }
                            @if (!string.IsNullOrWhiteSpace(p.Phone))
                            {
                                <a class="contact-row" href="tel:@p.Phone.Replace(" ", "")">
                                    <span class="ci"><i class="bi bi-telephone"></i></span>
                                    <span><small>Phone</small><b>@p.Phone</b></span>
                                </a>
                            }
                            @if (!string.IsNullOrWhiteSpace(p.TelegramUrl))
                            {
                                <a class="contact-row" href="@p.TelegramUrl" target="_blank">
                                    <span class="ci"><i class="bi bi-telegram"></i></span>
                                    <span><small>Telegram</small><b>Message me</b></span>
                                </a>
                            }
                            @if (!string.IsNullOrWhiteSpace(p.LinkedInUrl))
                            {
                                <a class="contact-row" href="@p.LinkedInUrl" target="_blank">
                                    <span class="ci"><i class="bi bi-linkedin"></i></span>
                                    <span><small>LinkedIn</small><b>Connect with me</b></span>
                                </a>
                            }
                            @if (!string.IsNullOrWhiteSpace(p.GitHubUrl))
                            {
                                <a class="contact-row" href="@p.GitHubUrl" target="_blank">
                                    <span class="ci"><i class="bi bi-github"></i></span>
                                    <span><small>GitHub</small><b>See my code</b></span>
                                </a>
                            }
                        </div>
                    </div>
                    <ContactForm RecipientEmail="@p.Email" />
                </div>
                @if (!string.IsNullOrWhiteSpace(p.ResumeUrl))
                {
                    <div class="reveal" style="text-align:center; margin-top:36px;">
                        <a href="@p.ResumeUrl" download class="btn-x btn-ghost-x">
                            <i class="bi bi-file-earmark-arrow-down"></i>Download my résumé (PDF)
                        </a>
                    </div>
                }
            </div>
        </section>

        <!-- ===================== FOOTER ===================== -->
        <footer class="footer">
            <div class="container-x footer-inner">
                <small>© @DateTime.UtcNow.Year @p.FullName. Built with ASP.NET Core, Blazor WASM &amp; SQL.</small>
                <div class="footer-socials">
                    @if (!string.IsNullOrWhiteSpace(p.GitHubUrl))
                    { <a class="icon-btn" href="@p.GitHubUrl" target="_blank" title="GitHub"><i class="bi bi-github"></i></a> }
                    @if (!string.IsNullOrWhiteSpace(p.LinkedInUrl))
                    { <a class="icon-btn" href="@p.LinkedInUrl" target="_blank" title="LinkedIn"><i class="bi bi-linkedin"></i></a> }
                    @if (!string.IsNullOrWhiteSpace(p.TelegramUrl))
                    { <a class="icon-btn" href="@p.TelegramUrl" target="_blank" title="Telegram"><i class="bi bi-telegram"></i></a> }
                </div>
            </div>
        </footer>
    </main>
}

@code {
    private SiteData? _data;
    private string _theme = "dark";
    private bool _navOpen;
    private bool _fxReady;

    private readonly (string, string)[] _navItems = new[]
    {
        ("about", "About"),
        ("services", "Services"),
        ("skills", "Skills"),
        ("education", "Education"),
        ("projects", "Projects"),
        ("contact", "Contact"),
    };

    protected override async Task OnInitializedAsync()
    {
        try
        {
            _data = await Http.GetFromJsonAsync<SiteData>("api/site") ?? new SiteData();
        }
        catch
        {
            _data = new SiteData();
        }

        // Record the visit (best effort) and reflect the new count.
        try
        {
            var res = await Http.PostAsync("api/visit", null);
            var body = await res.Content.ReadFromJsonAsync<VisitResult>();
            if (body is not null && _data is not null) _data.Visits = body.visits;
        }
        catch { /* non-critical */ }
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (_data is not null && !_fxReady)
        {
            _fxReady = true;
            try
            {
                _theme = await JS.InvokeAsync<string>("site.getTheme");
                await JS.InvokeVoidAsync("site.initScrollFx");
                StateHasChanged();
            }
            catch { }
        }
    }

    private async Task ToggleTheme()
    {
        _theme = await JS.InvokeAsync<string>("site.toggleTheme");
    }

    private void CloseNav() => _navOpen = false;

    private static string Initials(string name)
    {
        if (string.IsNullOrWhiteSpace(name)) return "•";
        var parts = name.Split(' ', StringSplitOptions.RemoveEmptyEntries);
        return parts.Length >= 2
            ? $"{char.ToUpper(parts[0][0])}{char.ToUpper(parts[1][0])}"
            : parts[0][..Math.Min(2, parts[0].Length)].ToUpper();
    }

    private static string FirstName(string name) =>
        string.IsNullOrWhiteSpace(name) ? "" : name.Split(' ')[0];

    private sealed class VisitResult { public long visits { get; set; } }
}
